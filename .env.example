NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Database Dialect ('postgres' or 'oracle') ──────────────────────────────
DB_DIALECT=postgres
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# ── Oracle Configuration (used when DB_DIALECT=oracle) ──────────────────────
ORACLE_USER=masjid
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10

# ── Security & Authentication ───────────────────────────────────────────────
JWT_SECRET=
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30

APP_BASE_URL=http://localhost:3000
