# Template for the VM's .env.prod — copy, fill in, and keep it OFF the VM's git history
# entirely (it isn't committed; docker-compose.prod.yml reads it via env_file). Real
# values belong in OCI Vault long-term, per docs/40-delivery/02-devops-and-cicd.md §4.

NODE_ENV=production
PORT=3000

# Autonomous Database connection details go here once provisioned. Autonomous DB
# typically requires either a downloaded wallet (mTLS) or a TLS-only connect string
# depending on how the instance's network access is configured — confirm the exact
# ORACLE_CONNECT_STRING format against the instance's own connection tab in the OCI
# console when it exists; this hasn't been tested against a real Autonomous DB instance,
# only the local gvenzl/oracle-free dev container.
ORACLE_USER=masjid
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10

JWT_SECRET=
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30

APP_BASE_URL=https://api.masjidos.example
