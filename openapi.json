                            "TENANT_NOT_FOUND",
                            "TENANT_SUSPENDED",
                            "TENANT_READONLY",
                            "VALIDATION_FAILED",
                            "RULE_FUND_RESTRICTION_VIOLATED",
                            "RULE_WAQF_CORPUS_PROTECTED",
                            "RULE_LEDGER_IMMUTABLE",
                            "RULE_LAST_ADMIN",
                            "SYNC_CURSOR_TOO_OLD",
