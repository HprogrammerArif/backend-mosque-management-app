                      "model": {
                        "type": "string",
                        "maxLength": 120
                      },
                      "appVersion": {
                        "type": "string",
                        "maxLength": 20
                      },
                      "pushToken": {
                        "type": "string",
                        "maxLength": 255
                      }
                    },
                    "required": [
                      "id",
                      "platform"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
