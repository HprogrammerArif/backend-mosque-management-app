{
  "name": "masjid-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "migrate": "tsx src/infrastructure/database/migrate-cli.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "lint": "eslint src",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "pnpm db:down && docker volume rm mosque-backend_oracle-data || true && pnpm db:up"
  },
  "dependencies": {
    "argon2": "^0.41.0",
    "dotenv": "^17.4.2",
    "jose": "^5.9.0",
    "oracledb": "^6.6.0",
    "pino": "^9.0.0",
    "uuidv7": "^1.0.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/oracledb": "^7.0.2",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "oracledb"
    ]
  }
}
